rules_version = '2';
// Smith's Classroom · Grenadier Town — Firestore security rules.
// Teachers sign in with email/password. Students sign in anonymously, join with a
// class code, and claim their name with a PIN. A student can only act as the
// student record whose uid matches their sign-in.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function cls(cid) { return get(/databases/$(database)/documents/classes/$(cid)).data; }
    function owns(cid) { return isTeacher() && cls(cid).ownerUid == request.auth.uid; }
    function member(cid) { return signedIn() && exists(/databases/$(database)/documents/classes/$(cid)/members/$(request.auth.uid)); }
    // the student record `sid` belongs to whoever is signed in
    function isSid(cid, sid) { return signedIn() && get(/databases/$(database)/documents/classes/$(cid)/students/$(sid)).data.uid == request.auth.uid; }
    function live(cid) { return cls(cid).frozen != true; }
    // a student from another class of the same teacher who flew here today (town/travel.js)
    function visa(cid) { return signedIn() && exists(/databases/$(database)/documents/classes/$(cid)/visas/$(request.auth.uid)); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // the elected mayor (the student record in classes/{cid}.mayor.sid belongs to whoever is signed in)
    function isMayor(cid) { return signedIn() && cls(cid).get('mayor', null) != null && cls(cid).mayor.get('sid', '') != ''
      && isSid(cid, cls(cid).mayor.sid); }
    // city jobs the mayor hires and fires; every other job stays with the teacher
    function publicJobs() { return ['firefighter','marshal','sanitation','ranger','builder','mail']; }

    match /codes/{code} {
      allow get: if signedIn();
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
    }

    match /classes/{cid} {
      allow get: if (isTeacher() && resource.data.ownerUid == request.auth.uid) || member(cid) || visa(cid);
      allow list: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isTeacher() && resource.data.ownerUid == request.auth.uid;
      // the mayor staffs public jobs: only staff/staffNames change, and only public-job seats
      allow update: if isMayor(cid) && resource.data.get('frozen', false) != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staff','staffNames'])
        && request.resource.data.get('staff', {}).diff(resource.data.get('staff', {})).affectedKeys().hasOnly(publicJobs());

      match /members/{uid} {
        allow get: if owns(cid) || (signedIn() && request.auth.uid == uid);
        allow list: if owns(cid);
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(cid));
        allow delete: if owns(cid);
      }

      // Private: PIN hash and cloud save. Locked to the device that set the PIN;
      // another device takes over only by proving the PIN (pinProof == pinHash).
      match /students/{sid} {
        allow get: if owns(cid) || (signedIn() && (resource == null || resource.data.uid == request.auth.uid
                                                   || resource.data.get('pinHash', null) == null));
        allow create: if member(cid) && request.resource.data.uid == request.auth.uid;
        allow update: if owns(cid) || (member(cid)
          && request.resource.data.uid == request.auth.uid
          && (resource.data.get('uid', null) == request.auth.uid
              || resource.data.get('pinHash', null) == null
              || request.resource.data.get('pinProof', '') == resource.data.pinHash)
          && (resource.data.get('pinHash', null) == null || request.resource.data.pinHash == resource.data.pinHash));
        allow list, delete: if owns(cid);
      }

      // Public profile: name, avatar, house
      match /pub/{sid} {
        allow read: if member(cid) || owns(cid) || visa(cid);
        allow write: if isSid(cid, sid) || owns(cid);
      }

      // Live plaza positions
      match /plaza/{sid} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if isSid(cid, sid) && live(cid);
        allow delete: if owns(cid);
      }

      // Quick chat: preset phrase ids only, and only while chat is on
      match /chat/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && cls(cid).chatOn == true && !(request.resource.data.sid in cls(cid).muted)
          && request.resource.data.p is string && request.resource.data.p.size() <= 24;
        allow delete: if owns(cid);
      }

      match /stickers/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.from) && live(cid);
        allow delete: if owns(cid);
      }

      // Market: the seller lists, any classmate can buy once, the teacher can undo
      match /market/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.seller) && live(cid)
          && request.resource.data.status == 'open' && request.resource.data.price is int
          && request.resource.data.price > 0
          && (cls(cid).econ.ceiling == 0 || request.resource.data.price <= cls(cid).econ.ceiling);
        allow update: if owns(cid)
          || (resource.data.status == 'open' && request.resource.data.status == 'sold' && live(cid)
              && isSid(cid, request.resource.data.buyer) && request.resource.data.buyer != resource.data.seller
              && onlyChanges(['status','buyer','buyerUid','buyerName','soldAt']))
          || (isSid(cid, resource.data.seller)
              && ((resource.data.status == 'open' && request.resource.data.status == 'cancelled' && onlyChanges(['status']))
                  || onlyChanges(['settled'])));
        allow delete: if owns(cid);
      }

      // Trades: both sides must agree; the teacher can undo
      match /trades/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.from) && live(cid)
          && request.resource.data.status == 'offered' && request.resource.data.to != request.resource.data.from;
        allow update: if owns(cid)
          || (isSid(cid, resource.data.to) && resource.data.status == 'offered'
              && request.resource.data.status in ['accepted','declined'] && onlyChanges(['status','respondedAt']))
          || (isSid(cid, resource.data.from)
              && ((resource.data.status == 'offered' && request.resource.data.status == 'cancelled' && onlyChanges(['status','respondedAt']))
                  || onlyChanges(['settled'])));
        allow delete: if owns(cid);
      }

      // ---- civic life (town/civic.js) ----
      // Election candidates: one per student per election, id = <eid>_<sid>
      match /candidates/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.eid + '_' + request.resource.data.sid
          && cls(cid).election.id == request.resource.data.eid && cls(cid).election.phase == 'filing'
          && request.resource.data.planks is list && request.resource.data.planks.size() <= 2;
        allow delete: if owns(cid) || isSid(cid, resource.data.sid);
      }
      // Secret ballot: one vote per student per election; only the teacher can read and count
      match /votes/{id} {
        allow read, delete: if owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.eid + '_' + request.resource.data.sid
          && cls(cid).election.id == request.resource.data.eid && cls(cid).election.phase == 'voting';
      }
      // Laws: only the mayor proposes; the teacher counts and can strike one down
      match /proposals/{id} {
        allow read: if member(cid) || owns(cid);
        // preset laws go straight to a vote; a law in the mayor's own words waits for the teacher's review
        allow create: if owns(cid) || (isSid(cid, request.resource.data.sid) && live(cid)
          && cls(cid).mayor.sid == request.resource.data.sid
          && ((request.resource.data.key != 'custom' && request.resource.data.status == 'voting')
              || (request.resource.data.key == 'custom' && request.resource.data.status == 'review'
                  && request.resource.data.title is string && request.resource.data.title.size() <= 40
                  && request.resource.data.desc is string && request.resource.data.desc.size() <= 140)));
        allow update, delete: if owns(cid);
      }
      match /lawvotes/{id} {
        allow read, delete: if owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.pid + '_' + request.resource.data.sid && request.resource.data.v is bool;
      }
      // Home of the Week: one vote per student per week (not secret), id = <week>_<sid>
      match /hotw/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.w + '_' + request.resource.data.sid && request.resource.data.for != request.resource.data.sid;
        allow delete: if owns(cid);
      }
      // Business partners: the seller sends the partner their half of the profit
      match /payouts/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.from) && live(cid)
          && request.resource.data.coins is int && request.resource.data.coins > 0 && request.resource.data.coins <= 500
          && request.resource.data.to != request.resource.data.from;
        allow update: if owns(cid) || (isSid(cid, resource.data.to) && onlyChanges(['settled']));
        allow delete: if owns(cid);
      }
      // ---- careers, Downtown and town requests (town/careers.js) ----
      // Job applications: one per student per job (id = <job>_<sid>); the teacher hires or denies
      match /apps/{id} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if owns(cid) || (isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.job + '_' + request.resource.data.sid && request.resource.data.status == 'pending'
          && request.resource.data.why is string && request.resource.data.why.size() <= 240
          && request.resource.data.skills is string && request.resource.data.skills.size() <= 240
          && request.resource.data.ref is string && request.resource.data.ref.size() <= 40);
        // the mayor hires or turns down applicants for public jobs
        allow update: if isMayor(cid) && live(cid) && resource.data.job in publicJobs()
          && onlyChanges(['status','decidedAt','decidedBy']) && request.resource.data.status in ['hired','denied'];
        allow delete: if owns(cid) || isSid(cid, resource.data.sid);
      }
      // A student asks the teacher to allow a word the filter blocked; approved words go in classes/{cid}.allowWords
      match /wordreqs/{id} {
        allow read: if owns(cid) || (signedIn() && isSid(cid, resource.data.sid));
        allow create, update: if owns(cid) || (isSid(cid, request.resource.data.sid) && request.resource.data.status == 'open'
          && id == request.resource.data.word + '_' + request.resource.data.sid
          && request.resource.data.word is string && request.resource.data.word.size() <= 40
          && request.resource.data.text is string && request.resource.data.text.size() <= 240);
        allow delete: if owns(cid);
      }
      // Game Hall: a match between two students (town/games.js). Either player can move; the
      // players, the game and the wager can't change after the challenge is sent.
      match /games/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.a) && live(cid) && request.resource.data.status == 'invited'
          && request.resource.data.kind in ['rps','colors','four','bj','checkers','chess']
          && request.resource.data.wager is int && request.resource.data.wager >= 0 && request.resource.data.wager <= 25
          && request.resource.data.b is string && request.resource.data.b != request.resource.data.a;
        allow update: if live(cid) && (isSid(cid, resource.data.a) || isSid(cid, resource.data.b))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','qa','qb','turn','winner','st','pa','pb','upd','resigned']);
        allow delete: if owns(cid);
      }
      // Orange Grove farms (town/farm.js): plots p1..p12, one per student; farmhands may tend
      match /farms/{p} {
        allow read: if member(cid) || owns(cid);
        allow create: if p.matches('p([1-9]|1[0-2])') && isSid(cid, request.resource.data.sid) && live(cid)
          && request.resource.data.beds is list && request.resource.data.beds.size() == 6;
        allow update: if live(cid) && request.resource.data.sid == resource.data.sid && (
          isSid(cid, resource.data.sid)
          || (request.resource.data.by in resource.data.hands && isSid(cid, request.resource.data.by)
              && onlyChanges(['beds','stash','owed','feedOwed','fed','hungry','by','upd'])));
        allow delete: if owns(cid) || isSid(cid, resource.data.sid);
      }
      // weekly Farm Supply purchases and Farmers Market sales (drive scarcity prices)
      match /supply/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.n is int
          && request.resource.data.n >= 1 && request.resource.data.n <= 3 && request.resource.data.item is string;
        allow delete: if owns(cid);
      }
      match /sales/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.n is int
          && request.resource.data.n >= 1 && request.resource.data.n <= 99 && request.resource.data.good is string;
        allow delete: if owns(cid);
      }
      // Justice Center (town/justice.js): citations by marshals, jail, lawsuits, break-ins
      match /citations/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if live(cid) && (owns(cid) || (isSid(cid, request.resource.data.by)
          && request.resource.data.by in cls(cid).get('staff', {}).get('marshal', [])))
          && request.resource.data.status == 'open' && request.resource.data.fine is int && request.resource.data.fine <= 10;
        allow update: if owns(cid) || (live(cid) && (
          (isSid(cid, resource.data.to) && request.resource.data.status in ['paid','contested'] && onlyChanges(['status','upd']))
          || (isSid(cid, resource.data.by) && request.resource.data.status == 'dismissed' && onlyChanges(['status','upd']))
          || (resource.data.status == 'contested' && cls(cid).get('staff', {}).get('judge', []).size() > 0
              && isSid(cid, cls(cid).staff.judge[0]) && onlyChanges(['status','ruled','ruledBy','upd']))));
        allow delete: if owns(cid);
      }
      match /jail/{sid} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if owns(cid) || (live(cid) && cls(cid).get('justice', {}).get('jail', true) != false && (
          (request.resource.data.self == true && isSid(cid, sid) && request.resource.data.sid == sid
            && request.resource.data.until <= request.time.toMillis() + 900000)
          || (request.resource.data.self != true && isSid(cid, request.resource.data.by)
            && request.resource.data.by in cls(cid).get('staff', {}).get('marshal', [])
            && request.resource.data.until <= request.time.toMillis() + 900000)
          || (resource != null && isSid(cid, sid) && onlyChanges(['until','served']) && request.resource.data.until <= resource.data.until)
          || (resource != null && isSid(cid, resource.data.by) && onlyChanges(['until']) && request.resource.data.until <= resource.data.until)));
        allow delete: if owns(cid);
      }
      match /suits/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.a) && live(cid) && request.resource.data.status == 'filed'
          && request.resource.data.amt is int && request.resource.data.amt >= 1 && request.resource.data.amt <= 20
          && request.resource.data.b != request.resource.data.a;
        allow update: if owns(cid) || (member(cid) && live(cid) && resource.data.status in ['filed','trial']
          && onlyChanges(['status','winner','la','laName','lb','lbName','sa','sb','ta','tb','jury','upd','voided']));
        allow delete: if owns(cid);
      }
      match /breakins/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if live(cid) && cls(cid).get('justice', {}).get('breakins', false) == true
          && isSid(cid, request.resource.data.by) && id == request.resource.data.day + '_' + request.resource.data.by
          && request.resource.data.take is int && request.resource.data.take <= 10 && request.resource.data.to != request.resource.data.by;
        allow delete: if owns(cid);
      }
      // Phase 4 places (town/travel.js)
      match /carbuys/{id} { allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.model in ['scooter','compact','pickup','ev','sports']; allow delete: if owns(cid); }
      match /mallbuys/{id} { allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.item is string; allow delete: if owns(cid); }
      match /shows/{id} { allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && id == request.resource.data.day + '_' + request.resource.data.sid
          && request.resource.data.score is int && request.resource.data.score <= 600; allow delete: if owns(cid); }
      match /museum/{id} { allow read: if member(cid) || owns(cid) || visa(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.item is string; allow delete: if owns(cid); }
      match /voyages/{id} { allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && id == request.resource.data.week + '_' + request.resource.data.sid
          && request.resource.data.stake is int && request.resource.data.stake >= 1 && request.resource.data.stake <= 10
          && request.resource.data.ship in ['sloop','freight','galleon']; allow delete: if owns(cid); }
      // visitors: a visa is proof you're a student of a class with the same teacher and the routes are open
      match /visas/{uid} { allow read: if owns(cid) || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid && isSid(request.resource.data.from, request.resource.data.sid)
          && cls(request.resource.data.from).ownerUid == cls(cid).ownerUid
          && cls(request.resource.data.from).get('sisters', []).size() > 0; allow delete: if owns(cid); }
      match /guestbook/{id} { allow read: if member(cid) || owns(cid) || visa(cid);
        allow create: if visa(cid) && request.resource.data.uid == request.auth.uid && request.resource.data.msg is string && request.resource.data.msg.size() <= 120;
        allow delete: if owns(cid); }
      match /greets/{id} { allow read: if member(cid) || owns(cid) || visa(cid);
        allow create: if visa(cid) && request.resource.data.uid == request.auth.uid && request.resource.data.e in ['👋','🤝','🎉'];
        allow delete: if owns(cid); }
      // Phase 5 (town/records.js): gigs between classmates and the wanted board
      match /gigs/{id} { allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.by) && live(cid) && request.resource.data.status == 'open'
          && request.resource.data.pay is int && request.resource.data.pay >= 2 && request.resource.data.pay <= 15;
        allow update: if owns(cid) || (live(cid) && (isSid(cid, resource.data.by)
            || (resource.data.status == 'open' && isSid(cid, request.resource.data.worker))
            || (resource.data.worker != '' && isSid(cid, resource.data.worker)))
          && request.resource.data.by == resource.data.by && request.resource.data.pay == resource.data.pay
          && onlyChanges(['status','worker','workerName','takenAt','right','doneAt','stars','auto','upd']));
        allow delete: if owns(cid); }
      match /wanted/{id} { allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.by) && live(cid) && request.resource.data.status == 'open'
          && request.resource.data.bounty is int && request.resource.data.bounty >= 1 && request.resource.data.bounty <= 30;
        allow update: if owns(cid) || (live(cid) && resource.data.status == 'open' && (
            (isSid(cid, resource.data.by) && request.resource.data.status == 'canceled' && onlyChanges(['status']))
            || (isSid(cid, request.resource.data.filler) && request.resource.data.status == 'filled' && onlyChanges(['status','filler','fillerName','filledAt']))));
        allow delete: if owns(cid); }
      // Weekly lottery tickets (town/economy.js): id = <week>_<sid>_<1..5>, 3 numbers "a-b-c"
      match /lottery/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id.matches(request.resource.data.week + '_' + request.resource.data.sid + '_[1-5]')
          && request.resource.data.nums is string && request.resource.data.nums.matches('[0-9]{1,2}-[0-9]{1,2}-[0-9]{1,2}');
        allow delete: if owns(cid);
      }
      // The mayor asks the teacher to fire someone; only the teacher decides
      match /firereqs/{id} {
        allow read: if owns(cid) || isSid(cid, resource.data.sid);
        allow create: if isMayor(cid) && live(cid) && request.resource.data.sid == cls(cid).mayor.sid
          && request.resource.data.status == 'open' && request.resource.data.why is string
          && request.resource.data.why.size() >= 10 && request.resource.data.why.size() <= 240;
        allow update, delete: if owns(cid);
      }
      // Cases: service requests and town events; only someone hired for that job can work or close one
      match /cases/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if owns(cid) || (isSid(cid, request.resource.data.by) && live(cid)
          && request.resource.data.kind in ['sick','checkup','pet','interview','loan','fire','report','claim','tutor','package','order','photo','litter','park']);
        allow update: if owns(cid) || (live(cid) && (
            (isSid(cid, request.resource.data.get('worker', '')) && request.resource.data.worker in cls(cid).staff[resource.data.job]
              && onlyChanges(['n','status','worker','workerName','doneAt','result']))
            || (resource.data.kind in ['litter','park'] && isSid(cid, request.resource.data.by) && request.resource.data.by in cls(cid).staff[resource.data.job])
            // a town NPC covers an empty job: the requester's app closes the case after 3 minutes
            || (isSid(cid, resource.data.for) && request.resource.data.worker == 'npc' && request.resource.data.status == 'done'
              && cls(cid).get('staff', {}).get(resource.data.job, []).size() == 0 && request.time.toMillis() > resource.data.at + 170000
              && onlyChanges(['n','status','worker','workerName','doneAt','result']))));
        allow delete: if owns(cid);
      }
      // Town project requests: anyone asks; the mayor (or teacher) approves; builders and donors add progress
      match /requests/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.status == 'review'
          && request.resource.data.note is string && request.resource.data.note.size() <= 100;
        allow update: if owns(cid) || (live(cid) && (
            (cls(cid).mayor.sid == request.resource.data.get('by', '') && isSid(cid, request.resource.data.by) && onlyChanges(['status','by','decidedAt'])
              && request.resource.data.status in ['approved','declined'])
            || (resource.data.status == 'approved' && onlyChanges(['coins','donors','n','builders','status','doneAt'])
              && (request.resource.data.status == 'approved' || (request.resource.data.status == 'done'
                  && request.resource.data.n >= request.resource.data.need && request.resource.data.coins >= request.resource.data.cost)))));
        allow delete: if owns(cid);
      }
      match /reqvotes/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && id == request.resource.data.rid + '_' + request.resource.data.sid;
        allow delete: if owns(cid);
      }
      // Gazette stories: only a hired reporter writes; the teacher publishes
      match /news/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && request.resource.data.sid in cls(cid).staff.reporter
          && request.resource.data.status == 'review'
          && request.resource.data.headline is string && request.resource.data.headline.size() <= 60
          && request.resource.data.body is string && request.resource.data.body.size() <= 400;
        allow update, delete: if owns(cid);
      }
      // Knocking: a visitor asks to come in; only the owner answers (id = <owner>_<visitor>)
      match /knocks/{id} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if (isSid(cid, request.resource.data.from) && live(cid)
            && id == request.resource.data.to + '_' + request.resource.data.from && request.resource.data.status == 'knock')
          || (resource != null && isSid(cid, resource.data.to) && onlyChanges(['status','respondedAt'])
            && request.resource.data.status in ['in','no']);
        allow delete: if owns(cid);
      }
      // Weekly story events: each student's right answers this week (id = <week>_<sid>)
      match /storypts/{id} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.week + '_' + request.resource.data.sid
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 60;
        allow delete: if owns(cid);
      }
      // House chats: only typed inside a house; word-filtered in the app; the teacher reads and deletes
      match /hchat/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && request.resource.data.kind in ['msg','join','party']
          && request.resource.data.text is string && request.resource.data.text.size() <= 140
          && (request.resource.data.kind != 'msg' || (cls(cid).get('chatOn', true) != false
              && !(request.resource.data.sid in cls(cid).get('muted', {}))));
        allow delete: if owns(cid);
      }
      // Live (town/live.js): period raid hits, one doc per student per day
      match /raid/{id} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.day + '_' + request.resource.data.sid
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n <= 200;
        allow delete: if owns(cid);
      }
      // Quiz duels: the challenger creates; the opponent can only add their score
      match /duels/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.a) && live(cid) && request.resource.data.a != request.resource.data.b
          && request.resource.data.status == 'open' && request.resource.data.bS == -1
          && request.resource.data.aS is int && request.resource.data.aS >= 0 && request.resource.data.aS <= 5
          && request.resource.data.qs is list && request.resource.data.qs.size() <= 5;
        allow update: if resource.data.status == 'open' && isSid(cid, resource.data.b)
          && onlyChanges(['bS','bT','status']) && request.resource.data.status == 'done'
          && request.resource.data.bS is int && request.resource.data.bS >= 0 && request.resource.data.bS <= 5;
        allow delete: if owns(cid);
      }
      // Town Feud: one entry per student per week; the side can't change once picked
      match /feud/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.week + '_' + request.resource.data.sid && request.resource.data.side in [0, 1]
          && request.resource.data.pts == 0;
        allow update: if owns(cid) || (isSid(cid, resource.data.sid) && live(cid)
          && request.resource.data.side == resource.data.side && request.resource.data.sid == resource.data.sid
          && request.resource.data.pts is int && request.resource.data.pts >= 0 && request.resource.data.pts <= 60
          && request.resource.data.arg is string && request.resource.data.arg.size() <= 140);
        allow delete: if owns(cid);
      }
      match /feudvotes/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.voter) && live(cid) && request.resource.data.voter != request.resource.data.target
          && id == request.resource.data.week + '_' + request.resource.data.voter + '_' + request.resource.data.target;
        allow delete: if owns(cid);
      }
      // High-fives: preset messages only (no free text)
      match /kudos/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.from) && live(cid) && request.resource.data.from != request.resource.data.to
          && request.resource.data.k in ['great','streak','house','study','work','kind'];
        allow delete: if owns(cid);
      }
      // Reviews of town workers: one per reviewer per worker per week
      match /reviews/{id} {
        allow read: if member(cid) || owns(cid);
        allow create, update: if owns(cid) || (isSid(cid, request.resource.data.by) && live(cid) && request.resource.data.by != request.resource.data.worker
          && id == request.resource.data.week + '_' + request.resource.data.by + '_' + request.resource.data.worker
          && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
          && request.resource.data.note is string && request.resource.data.note.size() <= 100);
        allow delete: if owns(cid);
      }
      // Weekly mystery: one accusation per student per week
      match /heist/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid)
          && id == request.resource.data.week + '_' + request.resource.data.sid && request.resource.data.ok is bool;
        allow delete: if owns(cid);
      }
      // Mayor's executive actions
      match /mayoracts/{id} {
        allow read: if member(cid) || owns(cid);
        allow create: if isSid(cid, request.resource.data.sid) && live(cid) && cls(cid).mayor.sid == request.resource.data.sid
          && request.resource.data.kind in ['holiday','challenge','proclaim','address','staffing']
          && request.resource.data.get('text', '').size() <= 280;
        allow delete: if owns(cid);
      }
      // Live plaza quiz answers: one per student per question; the teacher reads them
      match /buzz/{id} {
        allow read, delete: if owns(cid);
        allow create: if isSid(cid, request.resource.data.sid)
          && id == request.resource.data.qid + '_' + request.resource.data.sid && request.resource.data.a is int;
      }
    }

    // Period vs. period league: one small row per class, written by its members.
    // Only period names and totals live here (no student names).
    match /league/{owner}/periods/{cid} {
      allow read: if signedIn();
      allow write: if signedIn() && exists(/databases/$(database)/documents/classes/$(cid)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(cid)).data.ownerUid == owner
        && request.resource.data.total is int && request.resource.data.total >= 0 && request.resource.data.total < 10000000;
    }

    // Interstate Trade Post: furniture for sale between one teacher's periods (no student names)
    match /league/{owner}/market/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && exists(/databases/$(database)/documents/classes/$(request.resource.data.cid)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(request.resource.data.cid)).data.ownerUid == owner
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open'
        && request.resource.data.price is int && request.resource.data.price >= 1 && request.resource.data.price <= 100;
      allow update: if signedIn() && resource.data.status == 'open' && (
          (request.resource.data.status == 'sold' && request.resource.data.buyerCid != resource.data.cid
            && exists(/databases/$(database)/documents/classes/$(request.resource.data.buyerCid)/members/$(request.auth.uid))
            && get(/databases/$(database)/documents/classes/$(request.resource.data.buyerCid)).data.ownerUid == owner
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','buyerCid','buyerName','soldAt']))
          || (request.resource.data.status == 'cancel' && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])));
      allow delete: if false;
    }

    // Network test page (nettest.html) writes one small document per visit
    match /nettest/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
